---
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="11+ exam prep that's actually fun. Gamified learning, character guides, and zero stress." />
    <title>11+ Quest - Making Exam Prep Fun</title>
  </head>
  <body>
    <header class="hero">
      <nav>
        <div class="logo">🎮 11+ Quest</div>
        <ul class="nav-links">
          <li><a href="#features">Features</a></li>
          <li><a href="#subjects">Subjects</a></li>
          <li><a href="#about">About</a></li>
          <li><a href="/login" class="btn-primary">Start Your Quest</a></li>
        </ul>
      </nav>
      
      <div class="hero-content">
        <h1>11+ Prep That Doesn't Suck</h1>
        <p class="subtitle">Level up your character while mastering Maths, English, Verbal & Non-Verbal Reasoning. No stress, all fun.</p>
        <div class="cta-buttons">
          <a href="/start" class="btn-large btn-primary">Start Your Adventure 🚀</a>
          <a href="#how-it-works" class="btn-large btn-secondary">How It Works</a>
        </div>
        <p class="trust-text">✨ Free to start • No credit card needed • Actually fun</p>
      </div>
    </header>

    <section id="features" class="features">
      <h2>Why 11+ Quest?</h2>
      <div class="feature-grid">
        <div class="feature-card">
          <div class="feature-icon">🎮</div>
          <h3>Gamified Learning</h3>
          <p>Earn XP, level up your character, unlock achievements. Prep feels like playing a game.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🧩</div>
          <h3>Math Mysteries</h3>
          <p>Solve detective cases using maths. Word problems? More like adventure stories.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">😂</div>
          <h3>Grammar Memes</h3>
          <p>Learn punctuation through memes your friends will actually share.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">👥</div>
          <h3>Character Guides</h3>
          <p>Professor Numbers, Captain Comma, and more guide you through each subject.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🔥</div>
          <h3>Daily Streaks</h3>
          <p>Build habits with daily challenges. Don't break the streak!</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🏆</div>
          <h3>Leaderboards</h3>
          <p>Compete with friends (opt-in). Healthy competition, real rewards.</p>
        </div>
      </div>
    </section>

    <section id="subjects" class="subjects">
      <h2>Master Every Subject</h2>
      <div class="subject-grid">
        <div class="subject-card maths">
          <h3>📐 Maths</h3>
          <ul>
            <li>Number problems</li>
            <li>Geometry & angles</li>
            <li>Fractions & percentages</li>
            <li>Algebra basics</li>
            <li>Data handling</li>
          </ul>
        </div>
        <div class="subject-card english">
          <h3>📚 English</h3>
          <ul>
            <li>Comprehension</li>
            <li>Grammar & punctuation</li>
            <li>Spelling</li>
            <li>Vocabulary</li>
            <li>Writing skills</li>
          </ul>
        </div>
        <div class="subject-card vr">
          <h3>🔤 Verbal Reasoning</h3>
          <ul>
            <li>Word relationships</li>
            <li>Codes & patterns</li>
            <li>Logic puzzles</li>
            <li>Vocabulary challenges</li>
            <li>Following instructions</li>
          </ul>
        </div>
        <div class="subject-card nvr">
          <h3>🔷 Non-Verbal Reasoning</h3>
          <ul>
            <li>Pattern recognition</li>
            <li>Spatial awareness</li>
            <li>Sequences</li>
            <li>Rotations & reflections</li>
            <li>3D visualization</li>
          </ul>
        </div>
      </div>
    </section>

    <section id="how-it-works" class="how-it-works">
      <h2>How It Works</h2>
      <div class="steps">
        <div class="step">
          <div class="step-number">1</div>
          <h3>Create Your Character</h3>
          <p>Choose your avatar and pick a class (Mathematician, Wordsmith, or Detective).</p>
        </div>
        <div class="step">
          <div class="step-number">2</div>
          <h3>Choose Your Quest</h3>
          <p>Pick a subject and difficulty. Start with a quick warm-up or dive into a full mission.</p>
        </div>
        <div class="step">
          <div class="step-number">3</div>
          <h3>Earn & Level Up</h3>
          <p>Complete questions, earn XP, unlock achievements. Watch your character grow stronger!</p>
        </div>
        <div class="step">
          <div class="step-number">4</div>
          <h3>Track Progress</h3>
          <p>See your improvement over time. Parents get weekly reports (the fun kind).</p>
        </div>
      </div>
    </section>

    <section class="cta-section">
      <h2>Ready to Start Your Quest?</h2>
      <p>Join thousands of students who actually ENJOY 11+ prep.</p>
      <a href="/signup" class="btn-large btn-primary">Create Free Account ⚡</a>
      <p class="small-text">No credit card required • Start in 30 seconds</p>
    </section>

    <footer>
      <div class="footer-content">
        <div class="footer-section">
          <h4>11+ Quest</h4>
          <p>Making exam prep fun, one quest at a time.</p>
        </div>
        <div class="footer-section">
          <h4>Subjects</h4>
          <ul>
            <li><a href="/maths">Maths</a></li>
            <li><a href="/english">English</a></li>
            <li><a href="/verbal-reasoning">Verbal Reasoning</a></li>
            <li><a href="/non-verbal-reasoning">Non-Verbal Reasoning</a></li>
          </ul>
        </div>
        <div class="footer-section">
          <h4>Resources</h4>
          <ul>
            <li><a href="/parents">For Parents</a></li>
            <li><a href="/teachers">For Teachers</a></li>
            <li><a href="/blog">Blog</a></li>
            <li><a href="/faq">FAQ</a></li>
          </ul>
        </div>
        <div class="footer-section">
          <h4>Legal</h4>
          <ul>
            <li><a href="/privacy">Privacy Policy</a></li>
            <li><a href="/terms">Terms of Service</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; 2026 11+ Quest. Built with 🎮 and ☕</p>
      </div>
    </footer>
  </body>
</html>

<style>
  :root {
    --primary: #6366f1;
    --primary-dark: #4f46e5;
    --secondary: #f43f5e;
    --accent: #10b981;
    --dark: #1e293b;
    --light: #f8fafc;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: 'Inter', system-ui, sans-serif;
    line-height: 1.6;
    color: var(--dark);
  }

  .hero {
    background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
    color: white;
    padding: 2rem 1rem 6rem;
  }

  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 2rem;
  }

  .logo {
    font-size: 1.5rem;
    font-weight: bold;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
    list-style: none;
    align-items: center;
  }

  .nav-links a {
    color: white;
    text-decoration: none;
  }

  .hero-content {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
    padding: 4rem 2rem;
  }

  h1 {
    font-size: 3.5rem;
    margin-bottom: 1rem;
  }

  .subtitle {
    font-size: 1.25rem;
    margin-bottom: 2rem;
    opacity: 0.9;
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .btn-large {
    padding: 1rem 2rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: bold;
    transition: transform 0.2s;
  }

  .btn-large:hover {
    transform: translateY(-2px);
  }

  .btn-primary {
    background: white;
    color: var(--primary);
  }

  .btn-secondary {
    background: rgba(255,255,255,0.2);
    color: white;
    border: 2px solid white;
  }

  .trust-text {
    opacity: 0.8;
    font-size: 0.9rem;
  }

  section {
    padding: 4rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  h2 {
    text-align: center;
    font-size: 2.5rem;
    margin-bottom: 3rem;
  }

  .feature-grid, .subject-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  .feature-card, .subject-card {
    background: var(--light);
    padding: 2rem;
    border-radius: 12px;
    text-align: center;
  }

  .feature-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .subject-card ul {
    text-align: left;
    list-style: none;
    margin-top: 1rem;
  }

  .subject-card li {
    padding: 0.5rem 0;
    border-bottom: 1px solid #e2e8f0;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }

  .step {
    text-align: center;
  }

  .step-number {
    width: 60px;
    height: 60px;
    background: var(--primary);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: bold;
    margin: 0 auto 1rem;
  }

  .cta-section {
    background: var(--dark);
    color: white;
    text-align: center;
    border-radius: 12px;
    margin: 4rem auto;
  }

  footer {
    background: var(--dark);
    color: white;
    padding: 3rem 2rem 1rem;
  }

  .footer-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .footer-section h4 {
    margin-bottom: 1rem;
  }

  .footer-section ul {
    list-style: none;
  }

  .footer-section a {
    color: #94a3b8;
    text-decoration: none;
  }

  .footer-section a:hover {
    color: white;
  }

  .footer-bottom {
    text-align: center;
    padding-top: 2rem;
    margin-top: 2rem;
    border-top: 1px solid #334155;
    color: #94a3b8;
  }

  @media (max-width: 768px) {
    h1 {
      font-size: 2.5rem;
    }
    
    .nav-links {
      display: none;
    }
  }
</style>
